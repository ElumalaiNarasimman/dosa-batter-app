{
  "name": "dosa-batter-app",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "owner": "EXPO_PUBLIC_APP_MODE=owner expo start",
    "owner:web": "EXPO_PUBLIC_APP_MODE=owner expo start --web",
    "customer": "EXPO_PUBLIC_APP_MODE=customer expo start",
    "customer:web": "EXPO_PUBLIC_APP_MODE=customer expo start --web",
    "build:owner": "eas build --profile preview:owner --platform android",
    "build:customer": "eas build --profile preview:customer --platform android",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "expo": "^57.0.0",
    "expo-linking": "~57.0.12",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "eas-cli": "^24.11.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
