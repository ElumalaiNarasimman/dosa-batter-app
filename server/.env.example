# Copy this file to `.env` and fill in your PayPal app credentials.
# Get them from https://developer.paypal.com/dashboard/applications/sandbox
# (create a REST app; use the Sandbox client id/secret while testing).

PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# 'sandbox' for testing with fake money, 'live' for real charges.
PAYPAL_ENV=sandbox

# Stripe secret key. Get a TEST key (starts with sk_test_) from
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx

# Port the backend listens on.
PORT=4000

# PostgreSQL connection string for persisting orders (so the owner app sees
# customer orders). Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
#
# - On Render: do NOT set this. render.yaml injects it automatically from the
#   managed Postgres instance (fromDatabase connectionString).
# - Local dev: point it at a local or Docker Postgres, e.g.
#     DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/dosa
#   Leave it unset and the server still runs, but order endpoints are disabled.
DATABASE_URL=
